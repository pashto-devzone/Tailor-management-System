# ---------------------------------------------------------------------------
# Tailor Shop Management System - Backend configuration
#
# Copy this file to `.env` for local development, or set these variables in your
# hosting provider's dashboard. NEVER commit a real `.env` file.
# Values already present in the process environment always take precedence, so a
# hosting platform does not need this file at all.
# ---------------------------------------------------------------------------

# Application
# NODE_ENV=production enables production error masking and strict CORS.
NODE_ENV=development
PORT=5000
# Interface to bind. 0.0.0.0 is required by hosting platforms.
HOST=0.0.0.0

# Database (REQUIRED in production)
# PostgreSQL / Supabase is the only production database. Prefer the connection
# pooler (transaction or session mode) rather than the direct database host.
# Supabase's pooler uses a self-signed chain, hence sslmode=no-verify.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=no-verify

# Alternative: individual components. Used only when DATABASE_URL is empty.
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=postgres

# Optional pool tuning
# PGPOOL_MAX=5
# PGCONNECT_TIMEOUT_MS=3000

# Authentication (REQUIRED in production)
# Use long random values. At least 32 characters are enforced in production.
JWT_SECRET=
JWT_EXPIRES=7d
# API_KEY_SECRET signs store integration API keys (HMAC-SHA256).
API_KEY_SECRET=
# ADMIN_JWT_SECRET enables the /api/admin routes. Without it they return 503.
ADMIN_JWT_SECRET=

# Password recovery email (all required to enable Forgot Password).
# PASSWORD_RESET_URL must point to the frontend's /reset-password route.
# SMTP_PASS should be stored only in the deployment secret manager or local .env.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# PASSWORD_RESET_URL=https://your-app.example.com/reset-password

# CORS
# Comma-separated list of browser origins allowed in production, e.g.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Leave empty only for non-browser clients (Android, Electron, health probes),
# which send no Origin header and are always allowed.
ALLOWED_ORIGINS=
# Set to 1 to additionally allow localhost/private-network origins in
# production. Leave unset in production; it defaults to on in development.
ALLOW_PRIVATE_NETWORK_ORIGINS=

# Backup files (optional)
# Directory for generated backup ZIPs. Defaults to the user's Desktop on
# Windows and the system temp directory elsewhere. Ephemeral on most hosts.
# BACKUP_DIR=

# Desktop (set automatically by the Electron main process)
ELECTRON_RUN_AS_NODE=0
