# Android app environment configuration.
# Copy this file to `.env` and adjust the value for your network.
#
# This is the ONLY backend URL the Android app needs to know.
# It must point to your running Tailor Management System backend.
#
# For Expo Go on a physical phone, use the LAN IP of your computer
# (NOT localhost, because the phone cannot reach the PC's localhost).
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
